{#- The frame every page shares: cover, navigation, footer. -#}
{%- set isHome = page.url == "/" -%}
{%- set isEssay = kind == "essay" -%}
{%- set plainTitle = (title | plain) if title else "" -%}
{%- if isHome or not plainTitle -%}
  {%- set pageTitle = site.title + ((" · " + site.tagline) if site.tagline else "") -%}
{%- else -%}
  {%- set pageTitle = plainTitle + " · " + site.title -%}
{%- endif -%}
{%- set thisEssay = (collections.essays | getCollectionItem) if isEssay else null -%}
{%- if isEssay -%}
  {%- set pageDescription = thisEssay | excerpt(170) -%}
{%- else -%}
  {%- set pageDescription = (summary | plain) if summary else site.description -%}
{%- endif -%}
{%- set pageAuthor = author if (isEssay and author) else site.author -%}
{%- set shareTitle = plainTitle if (plainTitle and not isHome) else site.title -%}
{%- set shareImage = thisEssay | socialImage -%}
<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  {%- if pageAuthor %}
  <meta name="author" content="{{ pageAuthor }}">
  {%- endif %}
  <link rel="canonical" href="{{ page.url | fullUrl }}">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#5a1424">
  <meta name="format-detection" content="telephone=no">

  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ shareTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:type" content="{{ 'article' if isEssay else 'website' }}">
  <meta property="og:url" content="{{ page.url | fullUrl }}">
  <meta property="og:image" content="{{ shareImage }}">
  <meta property="og:locale" content="{{ site.language | replace('-', '_') }}">
  {%- if isEssay %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">

  <script>try{var s=parseFloat(localStorage.getItem("rr-text-size"));if(s>=90&&s<=140)document.documentElement.style.fontSize=s+"%"}catch(e){}</script>
  <link rel="preload" href="/assets/fonts/eb-garamond-roman-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/cormorant-garamond-italic-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | fresh }}">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/img/favicon-48.png" sizes="48x48" type="image/png">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  {%- if isEssay %}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": plainTitle,
    "datePublished": page.date | isoDate,
    "author": { "@type": "Person", "name": pageAuthor or site.owner },
    "image": shareImage,
    "mainEntityOfPage": page.url | fullUrl
  } | dump | safe }}</script>
  {%- endif %}
</head>
<body class="{{ 'is-home' if isHome else 'is-inner' }}" id="top">
  <a class="skip" href="#main">Skip to the writing</a>

  <header class="cover{{ ' cover--grand' if isHome }}">
    <div class="cover__frame">
      {%- if isHome %}
      {% include "partials/crown.njk" %}
      <h1 class="wordmark">
        <span class="wordmark__script">{{ site.titleLead }}</span>
        {%- if site.titleLast %} <span class="wordmark__caps">{{ site.titleLast }}</span>{% endif %}
      </h1>
      {%- if site.tagline %}
      <p class="cover__tagline">{{ site.tagline }}</p>
      {%- endif %}
      {%- else %}
      <p class="wordmark">
        <a href="/" aria-label="{{ site.title }}, home page">
          <span class="wordmark__script">{{ site.titleLead }}</span>
          {%- if site.titleLast %} <span class="wordmark__caps">{{ site.titleLast }}</span>{% endif %}
        </a>
      </p>
      {%- endif %}
    </div>
  </header>

  <div class="strip">
    <nav class="strip__nav" aria-label="Main">
      <a href="/"{% if isHome %} aria-current="page"{% endif %}>Home</a>
      <a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a>
    </nav>
    <div class="strip__size" data-text-size hidden>
      <span class="strip__label" aria-hidden="true">Text size</span>
      <button type="button" title="Make the text smaller">A&minus;<span class="sr-only"> Make the text smaller</span></button>
      <button type="button" title="Make the text larger">A+<span class="sr-only"> Make the text larger</span></button>
    </div>
  </div>

  <main id="main" class="page">
    {{ content | safe }}
  </main>

  <footer class="colophon">
    <p class="colophon__ornament" aria-hidden="true">&#x2619;&nbsp;&#x2766;&nbsp;&#x2767;</p>
    <p class="colophon__title">{{ site.title }}</p>
    <p class="colophon__legal">&copy; {{ build.year }} {{ site.owner }}. All rights reserved.</p>
    <p class="colophon__links">
      <a href="/">Home</a> <a href="/about/">About</a> <a href="/feed.xml">Feed</a>
    </p>
    <p class="colophon__top"><a href="#top">Back to top <span aria-hidden="true">&uarr;</span></a></p>
  </footer>

  <script>
  (function () {
    var KEY = "rr-text-size", STEPS = [90, 100, 112.5, 125, 140];
    var root = document.documentElement;
    var box = document.querySelector("[data-text-size]");
    if (!box) return;
    var buttons = box.querySelectorAll("button");
    function current() {
      var i = STEPS.indexOf(parseFloat(root.style.fontSize));
      return i < 0 ? 1 : i;
    }
    function apply(i) {
      root.style.fontSize = i === 1 ? "" : STEPS[i] + "%";
      try {
        if (i === 1) localStorage.removeItem(KEY); else localStorage.setItem(KEY, STEPS[i]);
      } catch (e) {}
      buttons[0].disabled = i === 0;
      buttons[1].disabled = i === STEPS.length - 1;
    }
    buttons[0].onclick = function () { apply(Math.max(0, current() - 1)); };
    buttons[1].onclick = function () { apply(Math.min(STEPS.length - 1, current() + 1)); };
    apply(current());
    box.hidden = false;
  })();
  </script>
</body>
</html>
